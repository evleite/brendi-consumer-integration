# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Brendi OAuth
BRENDI_CLIENT_ID=your_client_id
BRENDI_CLIENT_SECRET=your_client_secret
BRENDI_BASE_URL=https://api.brendi.com.br
BRENDI_TOKEN_URL=https://api.brendi.com.br/oauth/token
BRENDI_POLLING_INTERVAL_MS=300000

# Consumer
CONSUMER_API_KEYS=dev-key-123,test-key-456
CONSUMER_RATE_LIMIT_MAX=100

# Database (local docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brendi_consumer?schema=public

# Scheduler
POLLING_ENABLED=true
POLLING_INITIAL_DELAY_MS=10000